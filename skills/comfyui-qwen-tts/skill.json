      },
      {
        "method": "POST",
        "path": "/api/v1/ai/image/generate",
        "desc": "提交 TTS 工作流"
      },
      {
        "method": "GET",
        "path": "/api/v1/ai/tasks/{prompt_id}",
        "desc": "轮询任务状态"
      },
      {
        "method": "GET",
        "path": "/api/v1/ai/image/view/",
        "desc": "下载音频（type=temp）"
      }
    ],
    "timeout_sec": 300
  },
