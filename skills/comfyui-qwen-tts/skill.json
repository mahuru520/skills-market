    "url": ""
  },
  "readme": "SKILL.md",
  "files": [
    {"path": "SKILL.md", "type": "file", "size": 0},
    {"path": "scripts/tts_qwen.py", "type": "file", "size": 0},
    {"path": "scripts/workflow.json", "type": "file", "size": 0}
