{
  "id": "mcp/filesystem",
  "name": "filesystem",
  "display_name": "文件系统",
  "description": "MCP 官方文件系统服务器:受限目录内的读写文件、创建目录、移动、搜索文件。",
  "version": "1.0.1",
  "icon": "📁",
  "category": "filesystem",
  "kind": "mcp",
  "auth_method": "none",
  "owner": {
    "name": "modelcontextprotocol",
    "type": "official",
    "verified": true
  },
  "install_template": {
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "${FS_ROOT}"
    ]
  },
  "env_vars": [
    {
      "key": "FS_ROOT",
      "description": "允许访问的根目录(绝对路径)",
      "required": true,
      "example": "/home/user/projects"
    }
  ],
  "capabilities_summary": "read_file / write_file / create_directory / list_directory / move_file / search_files",
  "tags": [
    "official",
    "filesystem",
    "stdio"
  ],
  "install_count": 0,
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-09-24",
      "changes": [
        "补充 runtime_hint 首拉耗时提示",
