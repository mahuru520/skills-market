{
  "id": "mcp/memory",
  "name": "memory",
  "display_name": "知识图谱记忆",
  "description": "MCP 官方 Memory 服务器:基于知识图谱的持久记忆——实体、关系、观察的增删查。",
  "version": "1.0.1",
  "icon": "🧩",
  "category": "productivity",
  "kind": "mcp",
  "auth_method": "none",
  "owner": {
    "name": "modelcontextprotocol",
    "type": "official",
    "verified": true
  },
  "install_template": {
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-memory"
    ],
    "env": {
      "MEMORY_FILE_PATH": "${MEMORY_FILE_PATH}"
    }
  },
  "env_vars": [
    {
      "key": "MEMORY_FILE_PATH",
      "description": "知识图谱 JSON 存储文件路径(缺省用内置默认)",
      "required": false,
      "example": "/home/user/.mcp/memory.json"
    }
  ],
  "capabilities_summary": "create_entities / create_relations / add_observations / search_nodes / read_graph",
  "tags": [
    "official",
    "memory",
    "stdio"
  ],
  "install_count": 0,
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-09-24",
