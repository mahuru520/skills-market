{
  "id": "mcp/git",
  "name": "git",
  "display_name": "Git",
  "description": "MCP 官方 Git 服务器:仓库状态、diff、日志、分支管理、提交等本地 Git 操作。",
  "version": "1.0.1",
  "icon": "🌿",
  "category": "dev_tools",
  "kind": "mcp",
  "auth_method": "none",
  "owner": {
    "name": "modelcontextprotocol",
    "type": "official",
    "verified": true
  },
  "install_template": {
    "transport": "stdio",
    "command": "uvx",
    "args": [
      "mcp-server-git",
      "--repository",
      "${GIT_REPO_PATH}"
    ]
  },
  "env_vars": [
    {
      "key": "GIT_REPO_PATH",
      "description": "Git 仓库路径(默认当前工作目录)",
      "required": false,
      "example": "/home/user/projects/my-repo"
    }
  ],
  "capabilities_summary": "git_status / git_diff / git_log / git_create_branch / git_commit / git_push",
  "tags": [
    "official",
    "git",
    "stdio"
  ],
  "install_count": 0,
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-09-24",
      "changes": [
        "补充 runtime_hint 首拉耗时提示",
