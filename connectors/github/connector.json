{
  "id": "mcp/github",
  "name": "github",
  "display_name": "GitHub",
  "description": "MCP 官方 GitHub 服务器:仓库、文件、issue、PR、分支等全套 GitHub 操作能力。",
  "version": "1.0.0",
  "icon": "🐙",
  "category": "dev_tools",
  "kind": "mcp",
  "auth_method": "env_key",
  "owner": { "name": "modelcontextprotocol", "type": "community", "verified": false },
  "install_template": {
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github"],
    "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}" }
  },
  "env_vars": [
    {
      "key": "GITHUB_PERSONAL_ACCESS_TOKEN",
      "description": "GitHub 个人访问令牌(需 repo/issue 权限)",
      "required": true,
      "example": "ghp_xxxx",
      "source": "https://github.com/settings/tokens"
    }
  ],
  "capabilities_summary": "create_issue / list_issues / create_pull_request / search_repositories / get_file_contents 等",
  "tags": ["official", "github", "stdio"],
  "install_count": 0,
  "changelog": [
    { "version": "1.0.0", "date": "2026-09-23", "changes": ["首版上架"], "type": "feature" }
  ],
  "created_at": "2026-09-23T00:00:00Z",
  "updated_at": "2026-09-23T00:00:00Z"
}
